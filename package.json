{
  "name": "new1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types", 
    "start:http":"cd apps/http-server && npm run dist/index.js", 
    "start:web" : "cd apps/web && npm run start", 
    "start:ws":"cd apps/ws-server && npm run dist/index.js", 
    "generate:db" : "cd packages/db && npx prisma generate"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.6",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.16.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
